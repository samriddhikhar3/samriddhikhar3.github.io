{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "quarto-preview",
      "runtimeExecutable": "powershell",
      "runtimeArgs": [
        "-NoProfile",
        "-Command",
        "Get-ChildItem docs -Recurse -Filter *.qmd | Remove-Item; & 'C:\\Program Files\\Quarto\\bin\\quarto.exe' preview --port 3333 --no-browser"
      ],
      "port": 3333
    },
    {
      "name": "published-docs",
      "runtimeExecutable": "python",
      "runtimeArgs": ["-m", "http.server", "4000", "--directory", "docs"],
      "port": 4000
    },
    {
      "name": "live-worker",
      "runtimeExecutable": "powershell",
      "runtimeArgs": [
        "-NoProfile",
        "-Command",
        "$env:WRANGLER_SEND_METRICS = 'false'; Set-Location worker; npx.cmd wrangler dev --port 8787 --ip 127.0.0.1 --test-scheduled"
      ],
      "port": 8787
    }
  ]
}
